# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auth_db?retryWrites=true&w=majority

PORT=5174
NODE_ENV=development

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Brevo (https://www.brevo.com) - transactional email via HTTP API.
# Optional in development: if empty, emails are printed to the server console instead.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Auth App

# Frontend URL used in password reset links (required in production)
CLIENT_URL=http://localhost:5173
