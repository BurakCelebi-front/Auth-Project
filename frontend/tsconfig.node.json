{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "eslint.config.ts"]
}
