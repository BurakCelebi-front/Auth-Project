{
  "name": "auth-project",
  "version": "1.0.0",
  "description": "Advanced MERN authentication system with email verification and password reset",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch backend/server.ts",
    "dev:client": "npm run dev --prefix frontend",
    "build": "npm install --include=dev && npm run build:server && npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
